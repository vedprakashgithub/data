# Razorpay keys (get these from https://dashboard.razorpay.com/app/keys)
# Use TEST keys first, then switch to LIVE keys when ready
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Supabase credentials (same ones from your EduLMS project .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Comma-separated list of allowed origins (your deployed frontend URL)
# For local dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
